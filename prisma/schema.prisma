generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TEACHER
  STUDENT
}

enum LessonType {
  PDF
  VIDEO
}

enum AssignmentTarget {
  GRADE
  INDIVIDUAL
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  PASSED
  FAILED
}

enum FeeStatus {
  UNPAID
  PENDING
  PAID
}

enum AnnouncementTarget {
  EVERYONE
  SUBJECT
  GRADE
  SUBJECT_GRADE
  INSTITUTE
}

enum InquiryStatus {
  OPEN
  REVIEWED
  CLOSED
}

enum NotificationType {
  ASSIGNMENT_PUBLISHED
  LESSON_PUBLISHED
  ASSIGNMENT_GRADED
  HOMEWORK_SUBMITTED
  FEE_SUBMITTED
  FEE_REVIEWED
  ACCOUNT_DISABLED
  ACCOUNT_ENABLED
  DEADLINE_REMINDER
  ANNOUNCEMENT_PUBLISHED
  INQUIRY_SUBMITTED
  INQUIRY_UPDATED
  INQUIRY_STATUS_CHANGED
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               Role
  name               String
  whatsapp           String?
  age                Int?
  grade              String?
  school             String?
  stream             String?
  phone              String?
  avatarUrl          String?
  defaultCurrency     String?   @default("LKR")
  isDisabled         Boolean   @default(false)
  disableReason      String?
  disabledAt         DateTime?
  mustChangePassword Boolean   @default(false)
  instituteId        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  institute             Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  enrollments           Enrollment[]
  submissions           Submission[]
  feeRecords            FeeRecord[]
  notifications         Notification[]
  individualAssignments Assignment[] @relation("IndividualStudent")
  inquiries             Inquiry[]
  tagAssignments        StudentTagAssignment[]
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?
  monthlyFee  Decimal? @db.Decimal(10, 2)
  currency    String?  @default("LKR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]
  lessons     Lesson[]
  assignments Assignment[]
  feeRecords     FeeRecord[]
  announcements  Announcement[]
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
}

model Lesson {
  id          String     @id @default(cuid())
  title       String
  description String?
  type        LessonType
  contentUrl  String
  subjectId   String
  grade       String
  published   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Assignment {
  id                  String           @id @default(cuid())
  title               String
  instructions        String?
  attachmentUrl       String?
  subjectId           String
  grade               String?
  targetType          AssignmentTarget
  individualStudentId String?
  deadline            DateTime
  published           Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  subject           Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  individualStudent User?        @relation("IndividualStudent", fields: [individualStudentId], references: [id], onDelete: SetNull)
  submissions       Submission[]
}

model Submission {
  id            String           @id @default(cuid())
  assignmentId  String
  studentId     String
  status        SubmissionStatus @default(SUBMITTED)
  isLate        Boolean          @default(false)
  marks         Int?
  feedback      String?
  fileUrls      String[]
  attemptNumber Int              @default(1)
  portalOpen       Boolean   @default(true)
  resubmitDeadline DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, studentId])
}

model FeeRecord {
  id          String    @id @default(cuid())
  studentId   String
  subjectId   String
  month       Int
  year        Int
  status      FeeStatus @default(UNPAID)
  proofUrl    String?
  studentNote String?
  teacherNote String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, month, year])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}


model Institute {
  id        String   @id @default(cuid())
  name      String
  location  String
  logoUrl   String?
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students      User[]
  announcements Announcement[]
}

model Announcement {
  id          String             @id @default(cuid())
  title       String
  body        String
  targetType  AnnouncementTarget
  subjectId   String?
  grade       String?
  instituteId String?
  createdAt   DateTime           @default(now())
  subject     Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  institute   Institute?         @relation(fields: [instituteId], references: [id], onDelete: SetNull)
}

model Inquiry {
  id             String        @id @default(cuid())
  studentId      String
  title          String
  body           String
  status         InquiryStatus @default(OPEN)
  attachmentUrls String[]
  teacherNote    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  student        User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  edits          InquiryEdit[]
}

model InquiryEdit {
  id                String   @id @default(cuid())
  inquiryId         String
  titleBefore       String
  bodyBefore        String
  attachmentsBefore String[]
  editedAt          DateTime @default(now())
  inquiry           Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
}

model StudentTag {
  id          String                 @id @default(cuid())
  name        String                 @unique
  color       String?                @default("#2563eb")
  createdAt   DateTime               @default(now())
  assignments StudentTagAssignment[]
}

model StudentTagAssignment {
  id        String     @id @default(cuid())
  userId    String
  tagId     String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       StudentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
}
